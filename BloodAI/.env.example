# .env — copy this to .env and fill in your values
DISCORD_TOKEN=your_discord_bot_token_here

# ── Moonshot (default provider) ──────────────────────────────────────────────
MOONSHOT_API_KEY=your_moonshot_api_key_here

# ── Groq (legacy, only used when USE_GROQ_API=True in config.py) ─────────────
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# ── DeepSeek (paid, last resort when Groq is exhausted) ──────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Identity ─────────────────────────────────────────────────────────────────
OWNER_ID=your_discord_user_id_here

# ── Tavily (web search — primary, DDGS is fallback) ───────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Self-advocacy channel (Blood sends capability requests here) ──────────────
# BLOODAI_REQUESTS_CHANNEL_ID=channel_id_here