# .env — copy this to .env and fill in your values
# See README.md for setup instructions

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
OWNER_ID=your_discord_user_id_here

# ── 9arm Gateway (primary chat LLM — OpenAI-compatible, Bearer auth) ─────────
# Set USE_GATEWAY_API=True to route the main chat through this gateway.
GATEWAY_API_KEY=your_gateway_api_key_here
GATEWAY_BASE_URL=https://gateway.9arm.co/v1
GATEWAY_MODEL=qwen3.6-35b-a3b
USE_GATEWAY_API=True

# ── Moonshot / Fireworks (fallback LLM provider) ─────────────────────────────
# Get a key at https://fireworks.ai — used for Kimi K2 and fast vision
MOONSHOT_API_KEY=your_fireworks_api_key_here

# ── Xiaomi MiMo (OpenAI-compatible, Token Plan) ──────────────────────────────
# Get a key at https://platform.xiaomimimo.com — uses the `api-key` header
MIMO_API_KEY=your_xiaomimimo_api_key_here
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
# USE_MIMO_API=True

# ── Speech-to-text / VC transcription ───────────────────────────────────────
# First-run default only — /stt persists its on/off choice to data/stt_state.json.
STT_ENABLED=true
# Engine: local = on-device mlx-whisper (Apple Silicon GPU); groq = Groq Whisper API.
STT_ENGINE=local
# Local model (see stt_local.py). 4-bit large-v3 default (~1GB, good Thai, fits 8GB).
STT_MODEL=mlx-community/whisper-large-v3-mlx-4bit
# Language: blank = auto-detect (best for mixed Thai/English). Or force: th / en
STT_LANGUAGE=

# ── Auto reaction memes / GIFs toggle ────────────────────────────────────────
# true (default) = post a reaction GIF/meme after replies.
# false          = no auto GIFs/memes.
MEMES_ENABLED=true

# ── Groq (legacy fallback, only used when USE_GROQ_API=True in config.py) ────
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# ── Groq Orpheus TTS (the bot's voice for EVERYTHING it speaks) ──────────────
# OpenAI-compatible speech endpoint. Falls back to GROQ_API_KEY if unset.
GROQ_TTS_API_KEY=your_groq_api_key_here
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# Voices: autumn diana hannah austin daniel troy
GROQ_TTS_VOICE=troy
GROQ_TTS_FORMAT=wav
# Default vocal direction prepended to each line for emotion/sway (blank = off).
# Examples: cheerful, excited, happy. Per-line override: start text with [direction].
GROQ_TTS_STYLE=cheerful

# ── DeepSeek (paid, last resort when Groq is exhausted) ──────────────────────
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Tavily (web search/extraction — primary, DDGS is fallback) ───────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Spotify (mood-based music recommendations) ───────────────────────────────
# Get keys at https://developer.spotify.com/dashboard — Client Credentials flow
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ── Server IDs (optional — override defaults in config.py) ───────────────────
# ADMIN_ROLE_IDS=role_id_1,role_id_2
# MOD_ROLE_IDS=role_id_1
# TRACE_CHANNEL_ID=channel_id
# TERMINAL_CHANNEL_ID=channel_id
# DASHBOARD_CHANNEL_ID=channel_id
# BLOODAI_REQUESTS_CHANNEL_ID=channel_id
